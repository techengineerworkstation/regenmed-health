# Regen Med Health — Environment Variables
# Copy to .env locally, and set same vars in Vercel Dashboard > Settings > Environment Variables

# Existing DB (local MySQL fallback already in config.php)
# MySQL is optional - SQLite used if MySQL unreachable

# --- Supabase (Postgres) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- AI Scan (GPU) ---
SCAN_LOCAL_ENDPOINT=http://127.0.0.1:8080
SCAN_CLOUD_ENDPOINT=
# e.g. https://YOUR_RUNPOD_ID-8000.proxy.runpod.net  or  https://xxx.lambda.ai

# --- App ---
APP_URL=https://regenmed-health.vercel.app
