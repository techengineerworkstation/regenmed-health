# Deny execution of PHP files in uploads
<IfModule mod_php.c>
    php_flag engine Off
</IfModule>
<FilesMatch "\.(php|php3|php4|php5|phtml|pht|phar|phps|pl|py|sh|bash|exe|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
